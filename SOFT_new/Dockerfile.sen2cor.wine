FROM ubuntu:22.04

# Install prerequisites for WineHQ repo
RUN apt-get update -qq && \
    DEBIAN_FRONTEND=noninteractive apt-get install -y -qq \
        curl gnupg ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Add WineHQ repo for newer Wine (better ConcRT/PPL support)
RUN dpkg --add-architecture i386 && \
    mkdir -p /etc/apt/keyrings && \
    curl -fsSL https://dl.winehq.org/wine-builds/winehq.key | gpg --dearmor -o /etc/apt/keyrings/winehq.gpg && \
    echo "deb [signed-by=/etc/apt/keyrings/winehq.gpg] https://dl.winehq.org/wine-builds/ubuntu/ jammy main" > /etc/apt/sources.list.d/winehq.list && \
    apt-get update -qq && \
    DEBIAN_FRONTEND=noninteractive apt-get install -y -qq \
        winehq-stable winetricks cabextract \
        xvfb xauth \
        python3 python3-pip gdal-bin python3-gdal \
        unzip \
    && rm -rf /var/lib/apt/lists/*

# Initialize fresh Wine prefix (Wine 11 built-in ConcRT should handle PPL)
ENV WINEPREFIX=/opt/wine
ENV WINEARCH=win64
ENV DISPLAY=:99
# wineboot init
RUN rm -rf /opt/wine 2>/dev/null; true && \
    Xvfb :99 -screen 0 1024x768x16 & sleep 1 && \
    wineboot -u 2>/dev/null; sleep 3; \
    kill %1 2>/dev/null && \
    wine --version && echo "Prefix ready" || true

# Copy Sen2Cor 2.12.03 Windows distribution
COPY SOFT/Sen2Cor-02.12.03-win64 /opt/sen2cor-2.12.03

# Create sen2cor_data directories matching SOFT's structure
RUN mkdir -p /opt/sen2cor_data/NO-DEM/cfg /opt/sen2cor_data/NO-DEM/log \
             /opt/sen2cor_data/DEM-CAT/cfg /opt/sen2cor_data/DEM-CAT/log \
             /opt/sen2cor_data/DEM-SRTM/cfg /opt/sen2cor_data/DEM-SRTM/log

# Copy custom GIPP XMLs as default per-variant configs
COPY SOFT_new/configs/gipp/L2A_GIPP_NO_DEM.xml /opt/sen2cor_data/NO-DEM/cfg/L2A_GIPP.xml
COPY SOFT_new/configs/gipp/L2A_GIPP_DEM_CAT.xml /opt/sen2cor_data/DEM-CAT/cfg/L2A_GIPP.xml
COPY SOFT_new/configs/gipp/L2A_GIPP_DEM_SRTM.xml /opt/sen2cor_data/DEM-SRTM/cfg/L2A_GIPP.xml

# Pipeline code + scripts
COPY SOFT_new/scripts/ /workspace/scripts/
COPY SOFT_new/src/ /workspace/src/
COPY SOFT_new/configs/pipeline.json /workspace/configs/pipeline.json

# Wrapper scripts (matching SOFT's .bat behavior)
COPY SOFT_new/scripts/L2A_Process_NO-DEM.sh /usr/local/bin/L2A_Process_NO-DEM.sh
COPY SOFT_new/scripts/L2A_Process_DEM-CAT.sh /usr/local/bin/L2A_Process_DEM-CAT.sh
COPY SOFT_new/scripts/L2A_Process_DEM-SRTM.sh /usr/local/bin/L2A_Process_DEM-SRTM.sh
RUN chmod +x /usr/local/bin/L2A_Process_*.sh

# Python deps
COPY SOFT_new/requirements.txt /tmp/requirements.txt
RUN pip3 install --quiet --no-cache-dir -r /tmp/requirements.txt

ENV GDAL_DATA="/usr/share/gdal"
ENV PYTHONPATH="/workspace/src:$PYTHONPATH"
ENV PYTHONUNBUFFERED=1

WORKDIR /workspace
ENTRYPOINT ["python3", "-m", "s2_process.main"]
