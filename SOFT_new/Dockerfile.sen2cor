FROM kappazeta/sen2cor:v2.11.00

RUN apt-get update -qq && apt-get install -y -qq \
    python3-pip gdal-bin python3-gdal curl unzip && \
    rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip3 install --quiet --no-cache-dir -r requirements.txt

COPY scripts/ /workspace/scripts/
RUN python3 /workspace/scripts/patch_sen2cor.py

COPY configs/gipp/ /workspace/configs/gipp/
COPY configs/pipeline.json /workspace/configs/pipeline.json

COPY src/ /workspace/src/
COPY scripts/ /workspace/scripts/

ENV GDAL_DATA="/usr/share/gdal"
ENV PYTHONPATH="/workspace/src:$PYTHONPATH"
ENV PYTHONUNBUFFERED=1

WORKDIR /workspace
ENTRYPOINT ["python3", "-m", "s2_process.main"]
