# Credenciales Copernicus DataSpace (OData API)
CDSE_USERNAME=your_email@example.com
CDSE_PASSWORD=your_secure_password

# Credenciales S3 (Obtener de: https://dataspace.copernicus.eu / User Settings / S3 Access)
AWS_S3_ENDPOINT=https://eodata.dataspace.copernicus.eu
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
